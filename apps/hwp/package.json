{
  "name": "@genoffice/hwp",
  "productName": "Open GenOffice HWP",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Hangul word processor module (.hwp/.hwpx) built on the MIT-licensed rhwp editor, hosted by shell tabs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build:studio": "node ../../tools/build-hwp-studio.mjs",
    "build:cli": "node ../../tools/fetch-rhwp-cli.mjs",
    "build": "npm run build:studio && npm run build:cli && electron-vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@genoffice/agent-core": "*",
    "@genoffice/ai-provider": "*",
    "@genoffice/ui": "*",
    "@hwpforge/mcp": "^0.16.4",
    "@rhwp/core": "0.8.7",
    "@rhwp/editor": "0.8.7"
  },
  "devDependencies": {
    "@genoffice/doc-styles": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/i18n": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "@genoffice/file-parse": "*",
    "cfb": "^1.2.2",
    "@genoffice/work-wiki": "*"
  },
  "author": "Serge Doub and Open GenOffice contributors"
}
